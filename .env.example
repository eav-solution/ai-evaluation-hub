# Postgres connection for the api container is set in docker-compose.yml.
# For running the api or tests directly on the host:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evalhub
JWT_SECRET=dev-secret-change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-secret
AWS_REGION=us-east-1
S3_BUCKET=evalhub-datasets
MAX_UPLOAD_BYTES=52428800
MAX_DATASET_ROWS=5000
REDIS_URL=redis://localhost:6379/0
EVAL_BATCH_SIZE=8
# Keep false by default. Set true only for trusted local endpoint testing.
ALLOW_PRIVATE_ENDPOINTS=false
ENDPOINT_TIMEOUT_SECONDS=60
ENDPOINT_RETRIES=2
MAX_DOCUMENT_BYTES=20971520
MAX_DOCUMENT_EXPANDED_BYTES=104857600
MAX_DOCUMENT_PAGES=2000
MAX_DOCUMENT_CHARS=20000000
DOCUMENT_PARSE_TIMEOUT_SECONDS=30
DOCUMENT_PARSE_MEMORY_BYTES=536870912
MAX_DOCUMENTS_PER_JOB=10
GENERATION_CHUNK_CHARS=2000
GENERATION_CONTEXT_CHARS=300000
GENERATION_LEASE_SECONDS=900
PROVIDER_DISCOVERY_TIMEOUT_SECONDS=10
PROVIDER_DISCOVERY_MAX_BYTES=2097152
MAX_CUSTOM_CONNECTIONS=20
JUDGE_MAX_TOKENS=8192
GENERATION_MAX_TOKENS=8192
